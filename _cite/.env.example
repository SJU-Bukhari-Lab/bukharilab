# Copy this file to .env in the same directory (_cite/.env) and fill in real values.
# .env is already git-ignored, so it will never be committed.
#
# Only required if you want the Google Scholar publication source enabled
# (_cite/plugins/google-scholar.py). PubMed and ORCID sources need no key.

# SerpApi key used to query the Google Scholar Author API.
# Get one at https://serpapi.com/manage-api-key
GOOGLE_SCHOLAR_API_KEY=
